# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & secrets — NEVER COMMIT
.env
.env.*
*.env
*.local
config.*.local
config/*.local.yaml
config/*.local.json

# API keys / secrets patterns (defense in depth)
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.credentials/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Backups & temp
*.bak
*.bak.*
*.tmp
*.orig
*.rej
~*

# Workspace metadata (OpenClaw / Hermes — NOT for darwin repo)
.openclaw/
AGENTS.md
IDENTITY.md
SOUL.md
TOOLS.md
USER.md
HEARTBEAT.md

# OpenClaw per-session memory files (the darwin `memory/` source tree is
# the only `memory/` at the repo root and is restored by the negation
# below — see PR 13a). To ignore a different `memory/`, use a deeper
# explicit path.
memory/
!/memory/
!/memory/*.js
!/memory/*.json
!/memory/*.md

# PR-S1 (2026-06-15): v3+ SelfEvolution writes generated data here.
# ADR-008 mandates audit/ + proposals/ are NOT committed (they are runtime
# state, not source). The outer `memory/` rule does not match nested paths
# in older git versions; pin them explicitly.
memory/proposals/
memory/audit/
tmp/audit/

# Test artifacts
.nyc_output/
*.lcov
junit.xml

# Stray flag-like directories (the --version ghost-dir bug, 2026-06-18):
# anything starting with `--` at any depth is almost certainly a typo,
# tool misuse, or a Darwin self-evolve misadventure — never real source.
--*/

# Husky
.husky/_/
