#!/usr/bin/env node
/**
 * Darwin CLI — one-line installer entry point.
 *
 * V23: added --version / version subcommand for the one-click
 * installer (install.sh, install.ps1) to verify the install
 * without calling any other subcommand. Version is read from
 * package.json so it stays in sync with `npm version` bumps.
 *
 * V23 also refactored the subcommand dispatch into a table
 * (COMMANDS / SUBCOMMANDS) to keep main() under the
 * complexity=15 cap. Adding a new subcommand is now a one-line
 * entry in the table -- no new branch in main().
 *
 * Sub-commands:
 *   darwin version / --version / -V   print version and exit
 *   darwin chat "..."                 single-shot chat
 *   darwin config add <module>        interactive config add
 *   darwin config show                list configs, secrets redacted
 *   darwin repl                       persistent chat
 *   darwin plugin add <path>          load + init + enable a plugin
 *   darwin plugin list                list loaded plugins
 *   darwin memory show <key>          read a memory key
 *   darwin memory set <key> <val>     write a memory key (string MVP)
 *   darwin web [--port N] [--host H]  start the local web UI (V29-actual)
 *   darwin help                       this help
 */

import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
import { chat } from './lib/chat.js';
import { configAdd, configShow } from './lib/config.js';
import { repl } from './lib/repl.js';
import { pluginAdd, pluginList } from './lib/plugin.js';
import { memoryShow, memorySet } from './lib/memory.js';
import { webStart } from './lib/web.js';
import { selfEvolutionDispatch } from './lib/self-evolution.js';

// Resolve the package.json relative to this file (bin/darwin).
// Walking up handles both direct clone (~/.darwin/bin/darwin) and
// the npm-installed layout (node_modules/darwin/bin/darwin).
const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
function readVersion() {
  for (let i = 1; i <= 4; i += 1) {
    const candidate = join(__dirname, ...Array(i).fill('..'), 'package.json');
    try {
      const pkg = JSON.parse(readFileSync(candidate, 'utf8'));
      if (pkg && typeof pkg.version === 'string') {
        return { version: pkg.version, name: pkg.name || 'darwin' };
      }
    } catch {
      /* keep looking */
    }
  }
  return { version: '0.0.0-unknown', name: 'darwin' };
}

function showVersion() {
  const { version, name } = readVersion();
  process.stdout.write(name + ' v' + version + '\n');
}

const HELP = `Darwin v2 — digital life CLI

Usage:
  darwin version                    print version and exit
  darwin chat "..."                 single-shot chat (uses first configured provider)
  darwin repl                       persistent chat (Ctrl+D to exit, "clear" to wipe history)
  darwin config add <module>        interactive config add
  darwin config show                list configs (secrets redacted)
  darwin plugin add <path>          load + init + enable a plugin
  darwin plugin list                list loaded plugins
  darwin memory show <key>          read a memory key
  darwin memory set <key> <val>     write a memory key (string only MVP)
  darwin web [--port N] [--host H]  start the local web UI (V29-actual)
  darwin self-evolution <sub>       self-evolution 7 api (diagnose/propose/apply/verify/rollback/audit/learn)
  darwin help                       this help

Supported modules: provider-anthropic, provider-openai
`;

// Subcommand dispatch table. Each entry is (handler) where handler
// receives { argv, cmd, sub, rest } and returns a Promise.
// Adding a new subcommand = adding a single entry below.
const SUBCOMMANDS = {
  config: {
    add: ({ rest }) => configAdd(rest[0]),
    show: () => configShow(),
  },
  plugin: {
    add: ({ rest }) => pluginAdd(rest[0]),
    list: () => pluginList(),
  },
  memory: {
    show: ({ rest }) => memoryShow(rest[0]),
    set: ({ rest }) => memorySet(rest[0], rest.slice(1).join(' ')),
  },
};

// Top-level command dispatch. Version flags live outside the table
// so the installer can verify the install before main() does
// any provider / config work.
const COMMANDS = {
  version: () => showVersion(),
  chat: ({ argv }) => chat(argv.slice(1).join(' ').trim()),
  repl: () => repl(),
  'self-evolution': ({ sub, rest }) => selfEvolutionDispatch(sub, rest),
  web: ({ argv }) => webStart(argv.slice(1)),
};

function runNested(cmd, sub, rest, argv) {
  const group = SUBCOMMANDS[cmd];
  if (!group) {
    return false;
  }
  const handler = group[sub];
  if (!handler) {
    return false;
  }
  handler({ argv, cmd, sub, rest });
  return true;
}

async function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];
  const sub = argv[1];
  const rest = argv.slice(2);

  // Version flags first (used by install.sh to verify the install
  // without entering main()'s subcommand dispatch).
  if (cmd === '--version' || cmd === '-V') {
    showVersion();
    return;
  }

  // Top-level commands (no sub).
  if (cmd === 'version' || cmd === undefined || cmd === 'help' || cmd === '--help' || cmd === '-h') {
    if (cmd === 'version') {
      showVersion();
      return;
    }
    process.stdout.write(HELP);
    return;
  }

  // Nested subcommands (config/plugin/memory).
  if (runNested(cmd, sub, rest, argv)) {
    return;
  }

  // Top-level single-word commands.
  if (COMMANDS[cmd]) {
    await COMMANDS[cmd]({ argv, cmd, sub, rest });
    return;
  }

  // Unknown -- show help.
  process.stdout.write(HELP);
}

main().catch((e) => {
  process.stderr.write('x ' + (e?.message || String(e)) + '\n');
  process.exit(1);
});